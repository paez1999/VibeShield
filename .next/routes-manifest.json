    },
    {
      "page": "/api/scan-public",
      "regex": "^/api/scan\\-public(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/scan\\-public(?:/)?$"
    },
    {
      "page": "/api/scans",
      "regex": "^/api/scans(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/scans(?:/)?$"
    },
    {
      "page": "/api/vulns",
      "regex": "^/api/vulns(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/vulns(?:/)?$"
    },
    {
      "page": "/api/vulns/summary",
      "regex": "^/api/vulns/summary(?:/)?$",
